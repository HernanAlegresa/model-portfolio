---
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: `/${lang}/polaroids`, label: t('nav.polaroids') },
  { href: `/${lang}/work`, label: t('nav.work') },
  { href: `/${lang}/about`, label: t('nav.about') },
  { href: `/${lang}/contact`, label: t('nav.contact') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<header class="site-nav">
  <div class="site-nav__row">
    <LanguageSwitcher lang={lang} />
    <a class="site-nav__role" href={`/${lang}/`} aria-label={t('nav.home.label')}>
      {t('site.brand')}
    </a>
    <div class="site-nav__controls">
      <button
        type="button"
        class="site-nav__toggle"
        aria-expanded="false"
        aria-controls="primary-nav-overlay"
        aria-label={t('nav.menu.open')}
        data-label-open={t('nav.menu.open')}
        data-label-close={t('nav.menu.close')}
      >
        <span class="site-nav__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div id="primary-nav-overlay" class="nav-overlay" aria-hidden="true" inert>
  <nav class="nav-overlay__links" aria-label={t('nav.primary.label')}>
    {
      links.map((link) => (
        <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .site-nav {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 20;
    padding: var(--space-4) var(--page-margin);
  }

  /* Quiet scrim so nav text stays legible over any hero image, without a visible bar. */
  .site-nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(12 12 13 / 55%), transparent);
    pointer-events: none;
  }

  /* Three equal-weight columns so the center word stays optically centered on
     the page, whatever the widths of the controls on either side. */
  .site-nav__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .site-nav__role {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: 0 1px 12px rgb(12 12 13 / 60%);
  }

  .site-nav__controls {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-4);
  }

  .site-nav__toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* Three bars that collapse into an X via ::before/::after on open — CSS only. */
  .site-nav__toggle-bar,
  .site-nav__toggle-bar::before,
  .site-nav__toggle-bar::after {
    position: absolute;
    width: 1.25rem;
    height: 1.5px;
    background: var(--color-paper);
  }

  .site-nav__toggle-bar::before,
  .site-nav__toggle-bar::after {
    content: '';
    left: 0;
  }

  .site-nav__toggle-bar::before {
    top: -6px;
  }

  .site-nav__toggle-bar::after {
    top: 6px;
  }

  .site-nav__toggle[aria-expanded='true'] .site-nav__toggle-bar {
    background: transparent;
  }

  .site-nav__toggle[aria-expanded='true'] .site-nav__toggle-bar::before {
    top: 0;
    transform: rotate(45deg);
  }

  .site-nav__toggle[aria-expanded='true'] .site-nav__toggle-bar::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-nav__toggle-bar::before,
    .site-nav__toggle-bar::after {
      transition:
        top 180ms ease,
        transform 180ms ease;
    }
  }

  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 15;
    display: flex;
    align-items: center;
    padding: var(--nav-clearance) var(--page-margin) var(--space-6);
    background: var(--color-ink);
    opacity: 0;
    visibility: hidden;
  }

  .nav-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-overlay {
      transition:
        opacity 280ms ease,
        visibility 280ms;
    }
  }

  .nav-overlay__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .nav-overlay__links a {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 2rem + 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-paper);
    transition: color 150ms ease;
  }

  .nav-overlay__links a:hover,
  .nav-overlay__links a:focus-visible {
    color: var(--color-accent);
  }

  .nav-overlay__links a[aria-current='page'] {
    color: var(--color-smoke);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.12em;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const overlay = document.querySelector<HTMLElement>('#primary-nav-overlay');

  if (toggle && overlay) {
    let lastFocused: HTMLElement | null = null;

    const openLabel = toggle.dataset.labelOpen ?? '';
    const closeLabel = toggle.dataset.labelClose ?? '';

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') closeMenu();
    };

    function openMenu() {
      lastFocused = document.activeElement as HTMLElement | null;
      overlay!.removeAttribute('aria-hidden');
      overlay!.removeAttribute('inert');
      overlay!.classList.add('is-open');
      toggle!.setAttribute('aria-expanded', 'true');
      toggle!.setAttribute('aria-label', closeLabel);
      document.body.style.overflow = 'hidden';
      overlay!.querySelector<HTMLAnchorElement>('a')?.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function closeMenu() {
      overlay!.classList.remove('is-open');
      overlay!.setAttribute('aria-hidden', 'true');
      overlay!.setAttribute('inert', '');
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', openLabel);
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      lastFocused?.focus();
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    overlay.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  }
</script>
