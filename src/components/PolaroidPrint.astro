---
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';
import type { Polaroid } from '../data/polaroids';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  polaroid: Polaroid;
  lang: Lang;
  /** Rendered width of the print, for the browser to pick an image size. */
  sizes: string;
  class?: string;
}

const { polaroid, lang, sizes, class: className } = Astro.props;
const t = useTranslations(lang);
const caption = t(`polaroids.shot.${polaroid.shot}`);
---

<!-- One polaroid as a physical print: white paper border, deeper at the
     bottom, with the shot's name written on that strip. The photo is 3:4. -->
<figure class:list={['print', className]}>
  <div class="print__photo">
    {
      polaroid.image ? (
        <Image
          src={polaroid.image}
          alt={polaroid.alt?.[lang] ?? caption}
          widths={[400, 700, 1000, 1400]}
          sizes={sizes}
          loading="lazy"
          decoding="async"
          style={polaroid.position ? `object-position: ${polaroid.position};` : undefined}
        />
      ) : (
        <PlaceholderImage ratio="3 / 4" label={t('placeholder.label')} />
      )
    }
  </div>
  <figcaption class="print__caption">{caption}</figcaption>
</figure>

<style>
  .print {
    margin: 0;
    /* Percentages are of the print's width, so the border keeps the same
       proportion at any size, like a real instant print. */
    padding: 4.5% 4.5% 0;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .print__photo {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-ink-raised);
  }

  .print__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .print__photo :global(.placeholder) {
    height: 100%;
    border: 0;
  }

  .print__caption {
    padding: 0.85em 0 1.1em;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }
</style>
