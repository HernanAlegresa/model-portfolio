---
import PageHead from './PageHead.astro';
import { contact, whatsappUrl } from '../data/contact';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<PageHead title={t('nav.contact')} />

<section class="contact">
  <p class="contact__lead">{t('contact.lead')}</p>

  <dl class="contact__list" data-reveal-group>
    <div class="contact__row" data-reveal>
      <dt>{t('contact.instagram.label')}</dt>
      <dd>
        <a class="contact__link link-sweep" href={contact.instagram.url} target="_blank" rel="noopener noreferrer">
          {contact.instagram.handle}
        </a>
      </dd>
    </div>
    <div class="contact__row" data-reveal>
      <dt>{t('contact.email.label')}</dt>
      {
        contact.email ? (
          <dd><a class="link-sweep" href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        ) : (
          <dd class="contact__pending">{t('contact.email.pending')}</dd>
        )
      }
    </div>
    {
      contact.phone && (
        <div class="contact__row" data-reveal>
          <dt>{t('contact.phone.label')}</dt>
          <dd>
            <a class="contact__link link-sweep" href={`tel:${contact.phone.tel}`}>{contact.phone.display}</a>
            {contact.phone.whatsapp && (
              <a class="contact__whatsapp link-sweep" href={whatsappUrl(contact.phone.tel)} target="_blank" rel="noopener noreferrer">
                WhatsApp ↗
              </a>
            )}
          </dd>
        </div>
      )
    }
  </dl>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: center;
    min-height: 40svh;
    padding: 0 var(--page-margin) var(--space-7);
    text-align: center;
  }

  .contact__lead {
    max-width: 48ch;
    margin: 0;
    color: var(--color-smoke);
    font-size: var(--step-0);
  }

  .contact__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: min(100%, 32rem);
    margin: 0;
  }

  .contact__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-hairline);
  }

  .contact__row dt {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .contact__row dd {
    margin: 0;
    font-size: var(--step-2);
  }

  .contact__link {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .contact__pending {
    color: var(--color-smoke);
    font-style: italic;
  }

  .contact__whatsapp {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--step-0);
    text-decoration: none;
  }
</style>
