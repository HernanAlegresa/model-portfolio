---
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// One row per kind of work. The brands in each row come straight from the
// work collection (src/content/work/), so adding a project there updates
// this list too, with nothing to keep in sync by hand.
const CATEGORIES = ['modeling', 'ecommerce', 'content', 'events', 'tv-commercial'] as const;

const projects = (await getCollection('work')).sort((a, b) => a.data.priority - b.data.priority);

const rows = CATEGORIES.map((category) => ({
  category,
  name: t(`work.categories.${category}`),
  description: t(`home.services.${category}`),
  brands: projects.filter((p) => p.data.categories.includes(category)).map((p) => p.data.brand),
})).filter((row) => row.brands.length > 0);
---

<section class="services" aria-labelledby="services-title">
  <h2 id="services-title" class="services__title">{t('home.services.title')}</h2>

  <ul class="services__list" role="list">
    {
      rows.map((row) => (
        <li class="services__row">
          <h3 class="services__name">{row.name}</h3>
          <p class="services__description">{row.description}</p>
          <p class="services__brands">{row.brands.join(', ')}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services {
    padding: var(--space-8) var(--page-margin);
    border-top: 1px solid var(--color-hairline);
  }

  .services__title {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .services__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .services__row {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) 0;
  }

  /* The rule above each row is drawn by a pseudo-element so it can grow
     from the left on scroll (below). */
  .services__row::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--color-hairline);
    transform-origin: left;
  }

  .services__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .services__description {
    max-width: 40ch;
    margin: 0;
    color: var(--color-paper);
  }

  .services__brands {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  /* Desktop: discipline name on the left, what it involves in the middle,
     the brands on the right — one line per row, like a credits list. */
  @media (min-width: 56rem) {
    .services__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-4);
      align-items: baseline;
      padding: var(--space-5) 0;
    }

    .services__name {
      grid-column: 1 / 6;
    }

    .services__description {
      grid-column: 6 / 9;
    }

    .services__brands {
      grid-column: 9 / 13;
      text-align: right;
    }
  }

  /* Hover devices: the row under the pointer comes forward, its brands
     turning white; the rest of the list stays as it is. */
  @media (hover: hover) {
    .services__row:hover .services__brands {
      color: var(--color-paper);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .services__brands {
      transition: color 300ms ease;
    }

    .services__name {
      transition: translate 500ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    @media (hover: hover) {
      .services__row:hover .services__name {
        translate: 0.4rem 0;
      }
    }

    @supports (animation-timeline: view()) {
      .services__row::before {
        animation: rule-draw linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
    }
  }

  @keyframes rule-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
