---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import PlaceholderImage from '../PlaceholderImage.astro';
import { selectedWork } from '../../data/selected-work';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The Máxima Michaels reference: landscape cards, two per row, edge to
// edge. Its cards are 760×523 on a 1520px screen, i.e. a 1.45 ratio.
const RATIO = '1.45 / 1';

const shots = await Promise.all(
  selectedWork.map(async (shot) => {
    const entry = await getEntry('work', shot.work);
    // Fail the build on a typo'd slug instead of shipping an empty card.
    if (!entry) throw new Error(`selected-work.ts: no work entry "${shot.work}" in src/content/work/`);
    const { brand, categories } = entry.data;
    return {
      ...shot,
      brand,
      category: t(`work.categories.${categories[0]}`),
      alt: shot.alt?.[lang] ?? t('home.work.shot.alt').replace('{brand}', brand),
    };
  }),
);
---

<section class="works" aria-labelledby="works-title">
  <!-- The brand ticker above works as this section's heading, so the title
       is for screen readers only. -->
  <h2 id="works-title" class="visually-hidden">{t('home.work.title')}</h2>

  <ul class="works__grid" role="list">
    {
      shots.map((shot) => (
        <li class="works__item" data-reveal>
          <a class="works__card" href={`/${lang}/work#${shot.work}`}>
            <div class="works__media">
              {/* The photo twice: a full-bleed copy that blurs and darkens on
                  hover, and a sharp copy on top that shrinks into a framed
                  print over it. At rest the two line up exactly, so only
                  one photo is seen. The browser downloads the file once. */}
              <div class="works__layer works__layer--back">
                {shot.image ? (
                  <Image
                    src={shot.image}
                    alt={shot.alt}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 48rem) 50vw, 100vw"
                    style={shot.position && `object-position: ${shot.position}`}
                  />
                ) : (
                  <PlaceholderImage ratio={RATIO} label={t('placeholder.label')} />
                )}
              </div>
              <div class="works__layer works__layer--front" aria-hidden="true">
                {shot.image ? (
                  <Image
                    src={shot.image}
                    alt=""
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 48rem) 38vw, 76vw"
                    style={shot.position && `object-position: ${shot.position}`}
                  />
                ) : (
                  <PlaceholderImage ratio={RATIO} label={t('placeholder.label')} />
                )}
              </div>
            </div>

            <div class="works__caption">
              <p class="works__category">{shot.category}</p>
              <h3 class="works__brand">{shot.brand}</h3>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="works__more">
    <a class="works__button" href={`/${lang}/work`}>{t('home.work.cta')}</a>
  </div>
</section>

<style>
  /* Close under the brand ticker (it reads as this section's heading),
     the standard section gap below. */
  .works {
    padding: var(--space-5) 0 var(--section-gap);
  }

  /* Edge to edge, no gutter between the photos — the captions keep the
     page margin. One column on phones, two from tablets up. */
  .works__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .works__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-6);
    }
  }

  .works__card {
    display: block;
    text-decoration: none;
  }

  .works__media {
    position: relative;
    aspect-ratio: 1.45 / 1;
    overflow: hidden;
    background: var(--color-ink-raised);
  }

  .works__layer {
    position: absolute;
    inset: 0;
  }

  .works__layer :global(img),
  .works__layer :global(.placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dark veil over the back copy; invisible until hover. */
  .works__layer--back::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 59%);
    opacity: 0;
  }

  .works__caption {
    padding: 1.25rem var(--page-margin) 0;
  }

  .works__category {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.7rem + 0.35vw, 1.1rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #a6a6a6;
  }

  .works__brand {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.4rem, 1rem + 1.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* Solid white label button, centred under the grid. */
  .works__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
    padding: 0 var(--page-margin);
  }

  .works__button {
    padding: 0.7rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-paper);
  }

  .works__button:hover,
  .works__button:focus-visible {
    color: var(--color-paper);
    background: transparent;
  }

  /* The hover: the back copy blurs and darkens while the front copy shrinks
     to 76% — a sharp print lifted off its own blurred photo. Keyboard
     focus gets the same treatment. Hover-capable screens only; on touch
     the cards just link. */
  @media (hover: hover) {
    .works__card:hover .works__layer--back :global(img),
    .works__card:hover .works__layer--back :global(.placeholder),
    .works__card:focus-visible .works__layer--back :global(img),
    .works__card:focus-visible .works__layer--back :global(.placeholder) {
      filter: blur(8px);
      /* Slight zoom so the blur's soft edge stays outside the frame. */
      transform: scale(1.06);
    }

    .works__card:hover .works__layer--back::after,
    .works__card:focus-visible .works__layer--back::after {
      opacity: 1;
    }

    .works__card:hover .works__layer--front,
    .works__card:focus-visible .works__layer--front {
      transform: scale(0.76);
    }
  }

  .works__card:focus-visible {
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .works__layer--back :global(img),
    .works__layer--back :global(.placeholder),
    .works__layer--front {
      transition:
        transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
        filter 700ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .works__layer--back::after {
      transition: opacity 500ms ease;
    }

    .works__button {
      transition:
        background-color 250ms ease,
        color 250ms ease;
    }

    /* Right-hand cards arrive a beat after their left neighbour. */
    .works__item:nth-child(even) {
      transition-delay: 120ms;
    }
  }
</style>
