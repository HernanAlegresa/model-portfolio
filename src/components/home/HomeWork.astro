---
import WorkGrid from '../WorkGrid.astro';
import { selectedWork } from '../../data/selected-work';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="works" aria-labelledby="works-title">
  <!-- The brand ticker above works as this section's heading, so the title
       is for screen readers only. -->
  <h2 id="works-title" class="visually-hidden">{t('home.work.title')}</h2>

  <WorkGrid lang={lang} shots={selectedWork} />

  <div class="works__more">
    <a class="works__button" href={`/${lang}/work`}>{t('home.work.cta')}</a>
  </div>
</section>

<style>
  /* Close under the brand ticker (it reads as this section's heading),
     the standard section gap below. */
  .works {
    padding: var(--space-5) 0 var(--section-gap);
  }

  /* Solid white label button, centred under the grid. */
  .works__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
    padding: 0 var(--page-margin);
  }

  .works__button {
    padding: 0.7rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-paper);
  }

  .works__button:hover,
  .works__button:focus-visible {
    color: var(--color-paper);
    background: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .works__button {
      transition:
        background-color 250ms ease,
        color 250ms ease;
    }
  }
</style>
