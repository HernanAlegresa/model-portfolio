---
import PlaceholderImage from '../PlaceholderImage.astro';
import { profile, type StatField } from '../../data/profile';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// What a casting director looks for first, in comp-card order: height
// leads, then measurements, sizes, colouring. Values come from
// src/data/profile.ts; unconfirmed ones show "to be confirmed".
const format = (field: StatField<string | number>, unit = '') =>
  field.confirmed ? `${field.value}${unit ? ` ${unit}` : ''}` : t('about.stats.pending');

const stats = [
  { label: t('about.stats.height'), value: format(profile.heightCm, 'cm') },
  { label: t('about.stats.chest'), value: format(profile.chestCm, 'cm') },
  { label: t('about.stats.waist'), value: format(profile.waistCm, 'cm') },
  { label: t('about.stats.hip'), value: format(profile.hipCm, 'cm') },
  { label: t('about.stats.clothing'), value: format(profile.clothingSize) },
  { label: t('about.stats.shoe'), value: format(profile.shoeSizeEu, 'EU') },
  { label: t('about.stats.hair'), value: t('about.stats.hairValue') },
  { label: t('about.stats.eyes'), value: t('about.stats.eyesValue') },
];

const polaroids = [
  t('polaroids.shot.faceFront'),
  t('polaroids.shot.faceProfile'),
  t('polaroids.shot.bodyFront'),
  t('polaroids.shot.bodyProfile'),
];
---

<section class="stats" aria-labelledby="stats-title">
  <div class="stats__info">
    <!-- No visible label, like the other Home sections; screen readers
         still get the heading. -->
    <h2 id="stats-title" class="visually-hidden">{t('home.stats.title')}</h2>
    <p class="stats__intro">{t('home.stats.intro')}</p>

    <dl class="stats__list">
      {
        stats.map(({ label, value }) => (
          <div class="stats__item">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <a class="stats__polaroids" href={`/${lang}/polaroids`}>
    <ul class="stats__frames" role="list">
      {
        polaroids.map((label) => (
          <li class="stats__frame">
            <PlaceholderImage ratio="3 / 4" label={t('placeholder.label')} />
            <span class="stats__frame-label">{label}</span>
          </li>
        ))
      }
    </ul>
    <span class="stats__cta link-sweep">{t('home.stats.cta')}</span>
  </a>
</section>

<style>
  .stats {
    display: grid;
    gap: var(--space-6);
    padding: 0 var(--page-margin) var(--section-gap);
  }

  .stats__intro {
    max-width: 34ch;
    margin: 0 0 var(--space-5);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  /* Two columns of label-over-value pairs, like the back of a comp card. */
  .stats__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-4);
    margin: 0;
  }

  .stats__item {
    min-width: 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-hairline);
  }

  .stats__item dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .stats__item dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .stats__polaroids {
    display: block;
    text-decoration: none;
  }

  .stats__frames {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  /* Printed like an actual polaroid: white border, deeper at the bottom,
     with the shot's name written in that strip. */
  .stats__frame {
    min-width: 0;
    padding: 0.4rem 0.4rem 0;
    background: var(--color-paper);
  }

  .stats__frame :global(.placeholder) {
    border: 0;
  }

  .stats__frame-label {
    display: block;
    padding: 0.55rem 0.1rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .stats__cta {
    font-size: 0.95rem;
  }

  .stats__polaroids:hover .stats__cta,
  .stats__polaroids:focus-visible .stats__cta {
    background-size: 100% 1px;
  }

  @media (min-width: 40rem) {
    .stats__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .stats__frames {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Desktop: the card's facts on the left, the four polaroids on the right. */
  @media (min-width: 64rem) {
    .stats {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-4);
      align-items: end;
    }

    .stats__info {
      grid-column: 1 / 7;
    }

    .stats__polaroids {
      grid-column: 7 / 13;
    }
  }

  /* The polaroids fan out slightly on hover, like prints picked up from a
     table, then settle back. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .stats__frame {
      transition: rotate 500ms cubic-bezier(0.16, 1, 0.3, 1), translate 500ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .stats__polaroids:hover .stats__frame:nth-child(1) {
      rotate: -2deg;
      translate: -0.3rem -0.3rem;
    }

    .stats__polaroids:hover .stats__frame:nth-child(2) {
      rotate: 1.5deg;
      translate: 0.3rem -0.4rem;
    }

    .stats__polaroids:hover .stats__frame:nth-child(3) {
      rotate: 1deg;
      translate: -0.2rem 0.3rem;
    }

    .stats__polaroids:hover .stats__frame:nth-child(4) {
      rotate: -1.5deg;
      translate: 0.3rem 0.2rem;
    }
  }
</style>
