---
import PolaroidPrint from '../PolaroidPrint.astro';
import PolaroidLightbox from '../PolaroidLightbox.astro';
import { polaroids } from '../../data/polaroids';
import { profile, formatStatValue, type StatField } from '../../data/profile';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The polaroids lead; under them, only the five numbers a casting asks
// for first. The full sheet (sizes, colouring, age) lives on /about.
const stats: { label: string; field: StatField<number>; unit: string }[] = [
  { label: t('about.stats.height'), field: profile.heightCm, unit: 'cm' },
  { label: t('about.stats.weight'), field: profile.weightKg, unit: 'kg' },
  { label: t('about.stats.chest'), field: profile.chestCm, unit: 'cm' },
  { label: t('about.stats.waist'), field: profile.waistCm, unit: 'cm' },
  { label: t('about.stats.hip'), field: profile.hipCm, unit: 'cm' },
];
---

<section class="stats" aria-labelledby="stats-title">
  <!-- Section title on the left, as Máxima Michaels titles "Some works";
     the link to the full page sits on the same line, on the right. -->
  <header class="stats__head">
    <h2 id="stats-title" class="stats__title">{t('nav.polaroids')}</h2>
    <a class="stats__cta link-sweep" href={`/${lang}/polaroids`}>{t('home.stats.cta')}</a>
  </header>

  <!-- Each print is a link to its place on /polaroids; with JS it opens
       the full-screen viewer instead (PolaroidLightbox). -->
  <ul class="stats__prints" role="list">
    {
      polaroids.map((polaroid, index) => (
        <li>
          <a
            class="stats__print"
            href={`/${lang}/polaroids#${polaroid.id}`}
            data-lightbox-open={index}
            aria-label={`${t('home.stats.open')}: ${t(`polaroids.shot.${polaroid.shot}`)}`}
          >
            <PolaroidPrint
              polaroid={polaroid}
              lang={lang}
              sizes="(min-width: 48rem) 24vw, 46vw"
            />
          </a>
        </li>
      ))
    }
  </ul>

  <dl class="stats__list">
      {
        stats.map(({ label, field, unit }) => (
          <div class="stats__item">
            <dt>{label}</dt>
            <dd>
              {field.confirmed ? (
                <>
                  {formatStatValue(field.value, lang)}
                  <span class="stats__unit">{unit}</span>
                </>
              ) : (
                <span class="stats__unit">{t('about.stats.pending')}</span>
              )}
            </dd>
          </div>
        ))
      }
  </dl>

  <PolaroidLightbox lang={lang} />
</section>

<style>
  .stats {
    padding: 0 var(--page-margin) var(--section-gap);
  }

  .stats__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: clamp(2rem, 1rem + 4vw, 5.4rem);
  }

  /* Measured on Máxima's "Some works": 45px, uppercase, tight tracking. */
  .stats__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.9rem, 1.3rem + 1.6vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* The four prints across the full width (two by two on phones): they
     are the section. */
  .stats__prints {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stats__print {
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: zoom-in;
  }

  /* Under the prints, a single quiet line of numbers, centred, like the
     edge of a comp card: small mono labels, the values in the display face.
     Columns are as wide as their content, so even on a 320px phone the
     five fit side by side. */
  .stats__list {
    display: grid;
    grid-template-columns: repeat(5, auto);
    justify-content: space-between;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    text-align: center;
  }

  .stats__item {
    min-width: 0;
  }

  .stats__item dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .stats__item dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .stats__unit {
    margin-left: 0.2em;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .stats__cta {
    flex-shrink: 0;
    font-size: 0.95rem;
  }

  @media (min-width: 48rem) {
    .stats__prints {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }

    .stats__list {
      justify-content: center;
      column-gap: clamp(var(--space-4), 4vw, var(--space-6));
    }

    .stats__item dd {
      font-size: var(--step-1);
    }
  }

  /* Hover: the print under the cursor is picked up off the table (lifted,
     slightly tilted) while the others step back. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .stats__print {
      transition:
        rotate 500ms cubic-bezier(0.16, 1, 0.3, 1),
        translate 500ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 400ms ease;
    }

    .stats__prints:has(.stats__print:hover) .stats__print:not(:hover) {
      opacity: 0.55;
    }

    .stats__print:hover {
      translate: 0 -0.6rem;
    }

    li:nth-child(odd) .stats__print:hover {
      rotate: -1.5deg;
    }

    li:nth-child(even) .stats__print:hover {
      rotate: 1.5deg;
    }
  }
</style>
