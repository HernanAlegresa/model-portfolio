---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  section: string;
}

const { lang, section } = Astro.props;
const t = useTranslations(lang);
---

<section class="wip">
  <p class="wip__kicker">{section}</p>
  <h1 class="wip__title">{t('wip.title')}</h1>
  <p class="wip__body">{t('wip.body')}</p>
  <a class="wip__back" href={`/${lang}/`}>
    <span aria-hidden="true">&larr;</span> {t('wip.back')}
  </a>
</section>

<style>
  .wip {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 50svh;
    padding: var(--nav-clearance) var(--page-margin) var(--space-7);
  }

  .wip__kicker {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .wip__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 8vw, 5rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .wip__body {
    max-width: 40ch;
    color: var(--color-smoke);
  }

  .wip__back {
    width: max-content;
    margin-top: var(--space-3);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
</style>
