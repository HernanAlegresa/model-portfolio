---
import { getCollection } from 'astro:content';
import PlaceholderImage from './PlaceholderImage.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('work')).sort((a, b) => a.data.priority - b.data.priority);

// How many placeholder slots a project gets, based on how much real material
// exists for it (see docs/PROJECT-BRIEF.md) — projects with little material
// don't get forced into a gallery they can't fill.
const PLACEHOLDER_COUNT: Record<string, number> = {
  pending: 1,
  one: 1,
  few: 2,
  some: 4,
  many: 6,
};

const RATIOS = ['4 / 5', '1 / 1', '3 / 4', '16 / 9'];
---

<section class="work">
  <header class="work__head">
    <p class="work__kicker">{t('work.kicker')}</p>
    <h1 class="work__heading">{t('nav.work')}</h1>
    <p class="work__lead">{t('work.lead')}</p>
  </header>

  <div class="work__list">
    {
      projects.map((project) => {
        const { brand, year, categories, summary, material, note } = project.data;
        const count = PLACEHOLDER_COUNT[material.photos];
        return (
          <article class="work-item" id={project.id} data-reveal>
            <div class="work-item__head">
              <h2 class="work-item__brand">{brand}</h2>
              <div class="work-item__meta">
                <span class="work-item__year">{year}</span>
                {categories.map((category) => (
                  <span class="work-item__tag">{t(`work.categories.${category}`)}</span>
                ))}
                {material.hasVideo && <span class="work-item__tag work-item__tag--video">{t('work.card.video')}</span>}
              </div>
            </div>

            <p class="work-item__summary">{summary[lang]}</p>

            <div class="work-item__gallery" style={`--count: ${count}`}>
              {Array.from({ length: count }).map((_, i) => (
                <div class={`work-item__frame hover-zoom work-item__frame--${i % RATIOS.length}`}>
                  <PlaceholderImage
                    ratio={RATIOS[i % RATIOS.length]}
                    label={t('placeholder.label')}
                    accent={i === 0 ? 'wine' : 'neutral'}
                  />
                </div>
              ))}
            </div>

            {note && <p class="work-item__note"><strong>{t('work.card.note')}:</strong> {note[lang]}</p>}
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    padding: var(--nav-clearance) var(--page-margin) var(--space-7);
  }

  .work__kicker {
    margin: 0 0 var(--space-2);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .work__heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .work__lead {
    max-width: 48ch;
    margin: var(--space-3) 0 0;
    color: var(--color-smoke);
    font-size: var(--step-0);
  }

  .work__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .work-item {
    /* Home's selected-work frames link here by #slug. */
    scroll-margin-top: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .work-item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .work-item__brand {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-3);
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .work-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .work-item__year {
    color: var(--color-paper);
  }

  .work-item__tag {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-hairline);
  }

  .work-item__tag--video {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
  }

  .work-item__summary {
    max-width: 60ch;
    margin: 0;
    color: var(--color-paper);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .work-item__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .work-item__note {
    max-width: 60ch;
    margin: 0;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-smoke);
  }

  .work-item__note strong {
    font-style: normal;
  }

  @media (min-width: 48rem) {
    .work-item__gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .work-item__frame--1 {
      grid-row: span 1;
    }
  }
</style>
