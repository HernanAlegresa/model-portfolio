---
import { getCollection } from 'astro:content';
import HomeBrands from './home/HomeBrands.astro';
import WorkGrid from './WorkGrid.astro';
import { selectedWork, workOnlyShots, type SelectedShot } from '../data/selected-work';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Every brand, in curation order, as the same card the Home shows. A brand
// in the Home's six reuses that photo and framing (src/data/selected-work.ts);
// the others take theirs from `workOnlyShots` there, or show a placeholder.
const cards = [...selectedWork, ...workOnlyShots];
const shots: SelectedShot[] = (await getCollection('work'))
  .sort((a, b) => a.data.priority - b.data.priority)
  .map((entry) => cards.find((shot) => shot.work === entry.id) ?? { work: entry.id, image: null });
---

<!-- Laid out like the Máxima Michaels "Work" page: a big centred line, a
     small "(WORK)" under it, then the grid. The line is the visual title;
     the h1 is the small label, so the page's heading is still "Work". -->
<header class="work-head">
  <p class="work-head__statement">{t('work.statement')}</p>
  <h1 class="work-head__label">({t('nav.work')})</h1>
</header>

<HomeBrands lang={lang} />

<section class="work-grid" aria-label={t('nav.work')}>
  <WorkGrid lang={lang} shots={shots} headingLevel="h2" />
</section>

<style>
  /* Máxima at 1536px: 90px line centred, tracking −0.04em, its
     "(SOME WORK)" in 18px mono grey just under it, ~100px to the grid. */
  .work-head {
    padding: calc(var(--nav-clearance) + 6rem) var(--page-margin) clamp(3.5rem, 6.5vw, 6.25rem);
    text-align: center;
  }

  .work-head__statement {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.6rem, 5.86vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .work-head__label {
    margin: 1.75rem 0 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(0.85rem, 0.7rem + 0.45vw, 1.125rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #a6a6a6;
  }

  /* Close under the brand ticker, like on the Home. */
  .work-grid {
    padding: var(--space-5) 0 var(--section-gap);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The line rises out of its own baseline, then the label follows. */
    .work-head__statement {
      animation: work-rise 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .work-head__label {
      animation: work-fade 900ms 250ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes work-rise {
      from {
        clip-path: inset(0 0 100% 0);
        translate: 0 0.3em;
      }
      to {
        clip-path: inset(0 0 -0.2em 0);
        translate: 0 0;
      }
    }

    @keyframes work-fade {
      from {
        opacity: 0;
        translate: 0 0.5rem;
      }
    }
  }
</style>
