---
import PageHead from './PageHead.astro';
import { getCollection } from 'astro:content';
import HomeBrands from './home/HomeBrands.astro';
import WorkGrid from './WorkGrid.astro';
import { selectedWork, workCovers, workOnlyShots, type SelectedShot } from '../data/selected-work';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Every brand, in curation order, as the same card the Home shows. A brand
// in the Home's six reuses that photo and framing (src/data/selected-work.ts);
// the others take theirs from `workOnlyShots` there, or show a placeholder.
// `workCovers` comes first: it swaps a brand's photo on /work only.
const cards = [...workCovers, ...selectedWork, ...workOnlyShots];
const shots: SelectedShot[] = (await getCollection('work'))
  .sort((a, b) => a.data.priority - b.data.priority)
  .map((entry) => cards.find((shot) => shot.work === entry.id) ?? { work: entry.id, image: null });
---

<!-- A big centred line with a small "(WORK)" under it, then the grid, as
     on the Máxima Michaels "Work" page. The small label is the h1, so the
     page's heading is still "Work". -->
<PageHead title={t('work.statement')} label={t('nav.work')} />

<HomeBrands lang={lang} />

<section class="work-grid" aria-label={t('nav.work')}>
  <WorkGrid lang={lang} shots={shots} headingLevel="h2" />
</section>

<style>
  /* Close under the brand ticker, like on the Home. */
  .work-grid {
    padding: var(--space-5) 0 var(--section-gap);
  }

</style>
