---
import { languages, type Lang } from '../i18n/ui';
import { switchLocalePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
---

<div class="lang-switch">
  <button
    type="button"
    class="lang-switch__toggle"
    aria-expanded="false"
    aria-controls="lang-switch-panel"
    aria-label={`${t('nav.lang.label')}: ${languages[lang]}`}
  >
    <svg class="lang-switch__globe" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="12" cy="12" r="9.25" />
      <ellipse cx="12" cy="12" rx="4" ry="9.25" />
      <path d="M2.75 12h18.5M4.5 6.75h15M4.5 17.25h15" />
    </svg>
    <span class="lang-switch__code">{lang}</span>
  </button>

  <ul id="lang-switch-panel" class="lang-switch__panel" role="list">
    {
      Object.entries(languages).map(([code, label]) => (
        <li>
          <a
            href={switchLocalePath(pathname, code as Lang)}
            class="lang-switch__option"
            hreflang={code}
            lang={code}
            aria-current={code === lang ? 'true' : undefined}
          >
            <span class="lang-switch__option-code">{code}</span>
            <span>{label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang-switch {
    position: relative;
  }

  .lang-switch__toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0;
    color: var(--color-paper);
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lang-switch__globe {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  /* Hidden until the toggle opens it; `visibility` (not display:none) so the
     open/close can transition and the links leave the tab order when closed. */
  .lang-switch__panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 11rem;
    margin: 0;
    padding: 0.35rem 0 0;
    list-style: none;
    /* No box: just a top rule, so the options float over the hero like the
       rest of the nav. */
    border-top: 1px solid var(--color-hairline);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.35rem);
  }

  .lang-switch.is-open .lang-switch__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .lang-switch__option {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-smoke);
    text-shadow: 0 1px 12px rgb(12 12 13 / 60%);
  }

  .lang-switch__option-code {
    width: 1.5rem;
  }

  .lang-switch__option:hover,
  .lang-switch__option:focus-visible {
    color: var(--color-paper);
  }

  .lang-switch__option[aria-current='true'] {
    color: var(--color-paper);
  }

  .lang-switch__option[aria-current='true'] .lang-switch__option-code {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.3em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lang-switch__panel {
      transition:
        opacity 200ms ease,
        transform 240ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 200ms;
    }

    /* The globe makes a quarter turn on hover and while open — the one bit of
       play in an otherwise quiet control. */
    .lang-switch__globe {
      transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .lang-switch__toggle:hover .lang-switch__globe,
    .lang-switch.is-open .lang-switch__globe {
      transform: rotate(90deg);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.lang-switch');
  const toggle = root?.querySelector<HTMLButtonElement>('.lang-switch__toggle');

  if (root && toggle) {
    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close on outside click, on Escape (returning focus), and when focus leaves.
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) setOpen(false);
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
  }
</script>
