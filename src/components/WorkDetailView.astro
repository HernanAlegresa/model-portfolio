---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import WorkLightbox from './WorkLightbox.astro';
import { workPages, workHref } from '../data/work-pages';
import { displayNameWidth } from '../lib/display-name';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('work')).sort((a, b) => a.data.priority - b.data.priority);
const position = projects.findIndex((project) => project.id === slug);
const project = projects[position];
const page = workPages[slug];
if (!project || !page) throw new Error(`WorkDetailView: no work entry or media for "${slug}"`);

const { brand } = project.data;
const next = projects[(position + 1) % projects.length];

const pad = (n: number) => String(n).padStart(2, '0');

// Each photo links to its full-size file (what opens without JS; with JS
// the viewer opens instead). `at` is its place in the viewer.
const photos = await Promise.all(
  page.photos.map(async (photo, at) => ({
    ...photo,
    at,
    full: (await getImage({ src: photo.image, width: photo.image.width, format: 'webp' })).src,
  })),
);

// `pairs`: two photos per row, an odd one out closes the gallery on its
// own. `trios`: one grid, three across, every photo in the same 4:5 crop.
// `rows`: rows of one to three as listed in the page's `rows`, photos and
// films each at its own proportions, all of a row at the same height.
const trios = page.layout === 'trios';
const mixed = page.layout === 'rows';
const rows: (typeof photos)[] = [];
if (!mixed) for (let i = 0; i < photos.length; i += 2) rows.push(photos.slice(i, i + 2));

// A `fr` column per piece, as wide as its proportions.
const columns = (row: { ratio: number }[]) => row.map((item) => `${item.ratio.toFixed(4)}fr`).join(' ');

const mixedRows = await Promise.all(
  (mixed ? (page.rows ?? []) : []).map((row) =>
    Promise.all(
      row.map(async (item) => {
        if ('photo' in item) {
          const photo = photos[item.photo]!;
          return { kind: 'photo' as const, photo, ratio: photo.image.width / photo.image.height };
        }
        const { film } = item;
        const poster = (await getImage({ src: film.poster, width: 1280, format: 'webp' })).src;
        return { kind: 'film' as const, film: { ...film, poster }, ratio: film.width / film.height };
      }),
    ),
  ),
);

const clips = await Promise.all(
  page.videos.map(async (clip) => ({
    ...clip,
    poster: (await getImage({ src: clip.poster, width: 720, format: 'webp' })).src,
  })),
);

// The brand name's real width in em, letter by letter, so it can be sized
// to fill the page width exactly (see .project__name).
const nameWidth = displayNameWidth(brand).toFixed(4);
---

<article class="project" style={`--name-width: ${nameWidth}`}>
  <header class="project__head">
    <p class="project__index">
      <span>{pad(position + 1)} / {pad(projects.length)}</span>
      <a class="link-sweep" href={`/${lang}/work`}>{t('work.detail.all')}</a>
    </p>
    <!-- Shares a view-transition-name with this brand's card on the Home and
         on /work, so the name grows into place when coming from there. -->
    <h1 class="project__name" style={`view-transition-name: work-${slug}`}>{brand}</h1>
  </header>

  <section
    class={`project__gallery${trios ? ' project__gallery--trios' : ''}${mixed ? ' project__gallery--rows' : ''}`}
    aria-label={t('work.detail.gallery')}
  >
    {
      trios &&
        photos.map((photo) => (
          <figure class="project__frame" data-reveal>
            <a class="project__open" href={photo.full} data-photo-open={photo.at}>
              <Image
                src={photo.image}
                alt={photo.alt[lang]}
                widths={[480, 720, 960, 1280]}
                sizes={photo.at === 0 ? '(min-width: 48rem) 33vw, 100vw' : '(min-width: 48rem) 33vw, 50vw'}
                loading={photo.at < 3 ? 'eager' : 'lazy'}
                fetchpriority={photo.at === 0 ? 'high' : undefined}
                style={`object-position: ${photo.position ?? '50% 50%'}; transform-origin: ${photo.position ?? '50% 50%'}; --zoom: ${photo.zoom ?? 1}`}
              />
              <span class="visually-hidden">{t('work.photo.open')}</span>
            </a>
          </figure>
        ))
    }
    {
      !trios &&
      !mixed &&
      rows.map((row, index) => (
        <div class={`project__row${row.length === 1 ? ' project__row--single' : ''}`}>
          {row.map((photo) => (
            <figure class="project__frame" data-reveal>
              <a class="project__open" href={photo.full} data-photo-open={photo.at}>
                <Image
                  src={photo.image}
                  alt={photo.alt[lang]}
                  widths={[640, 960, 1280, 1717]}
                  sizes="(min-width: 48rem) 50vw, 100vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
                <span class="visually-hidden">{t('work.photo.open')}</span>
              </a>
            </figure>
          ))}
        </div>
      ))
    }
    {
      mixedRows.map((row, index) => (
        // Each column as wide as its photo's proportions, so every photo of
        // the row ends up the same height and the row fills the width.
        <div
          class={`project__row${row.length === 3 ? ' project__row--three' : ''}`}
          style={`--cols: ${columns(row)}; --cols-rest: ${columns(row.slice(1))}`}
        >
          {row.map((item, place) =>
            item.kind === 'film' ? (
              <figure
                class="project__frame project__frame--film"
                data-reveal
                style={`--ratio: ${item.film.width} / ${item.film.height}`}
              >
                {/* Like the backstage clips: controls without JS or with
                    reduced motion, silent autoplay on screen otherwise. */}
                <video
                  data-clip
                  controls
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={item.film.poster}
                  aria-label={item.film.label[lang]}
                >
                  <source src={item.film.src} type="video/mp4" />
                </video>
              </figure>
            ) : (
              <figure
                class="project__frame"
                data-reveal
                style={`aspect-ratio: ${item.photo.image.width} / ${item.photo.image.height}`}
              >
                <a class="project__open" href={item.photo.full} data-photo-open={item.photo.at}>
                  <Image
                    src={item.photo.image}
                    alt={item.photo.alt[lang]}
                    widths={[480, 640, 960, 1280, 1717]}
                    sizes={
                      row.length === 1
                        ? '100vw'
                        : row.length === 3
                          ? place === 0
                            ? '(min-width: 48rem) 33vw, 100vw'
                            : '(min-width: 48rem) 33vw, 50vw'
                          : '50vw'
                    }
                    loading={index < 2 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : undefined}
                    style={`object-position: ${item.photo.position ?? '50% 50%'}; transform-origin: ${item.photo.position ?? '50% 50%'}; --zoom: ${item.photo.zoom ?? 1}`}
                  />
                  <span class="visually-hidden">{t('work.photo.open')}</span>
                </a>
              </figure>
            ),
          )}
        </div>
      ))
    }
  </section>

  {
    clips.length > 0 && (
      <section class="project__backstage" aria-labelledby="backstage-title">
        <h2 id="backstage-title" class="project__label">
          {t('work.detail.backstage')}
        </h2>
        <ul
          class="project__clips"
          role="list"
          style={`--clips: ${Math.min(clips.length, 5)}; --slots: ${Math.min(Math.max(clips.length, 4), 5)}`}
        >
          {clips.map((clip) => (
            <li class="project__clip" data-reveal>
              {/* Controls by default, so the clips work without JS or with
                  reduced motion; the script swaps them for silent autoplay
                  while each clip is on screen. */}
              <video
                data-clip
                controls
                muted
                loop
                playsinline
                preload="none"
                poster={clip.poster}
                aria-label={clip.label[lang]}
              >
                <source src={clip.src} type="video/mp4" />
              </video>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <WorkLightbox lang={lang} photos={page.photos} />

  <nav class="project__next" aria-label={t('work.detail.nav')}>
    <p class="project__label-small">{t('work.detail.next')}</p>
    <a class="project__next-link" href={workHref(lang, next.id)}>
      <span style={`view-transition-name: work-${next.id}`}>{next.data.brand}</span>
    </a>
    <a class="project__button" href={`/${lang}/work`}>{t('work.detail.all')}</a>
  </nav>
</article>

<style>
  .project {
    /* The border of page colour around every photo and clip. */
    --frame: clamp(0.5rem, 0.8vw, 0.875rem);
    padding-top: var(--nav-clearance);
  }

  /* ---- Head: index line + the brand name across the full width ---- */

  .project__head {
    padding: 0 var(--page-margin);
    container-type: inline-size;
  }

  .project__index {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .project__index a {
    color: var(--color-paper);
  }

  /* Sized so any brand spans the full width, like the name on the Home
     hero: available width / the name's real width in em (measured letter
     by letter, src/lib/display-name.ts). The first letter lines up with
     the index line above (the -0.04em margin makes up for its side
     bearing); the last ends just inside the right margin. */
  .project__name {
    margin: 0 0 0 -0.04em;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: min(calc(100cqi / var(--name-width)), 16rem);
    line-height: 0.85;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ---- Photos: two per row, each in a thin frame of page colour ---- */

  /* The same gap between photos and around the outside edge, so every
     photo sits in an even border instead of touching its neighbour. */
  .project__gallery {
    display: grid;
    gap: var(--frame);
    margin-top: var(--space-5);
    padding: 0 var(--frame);
  }

  .project__frame {
    margin: 0;
    overflow: hidden;
    background: var(--color-ink-raised);
  }

  .project__frame :global(img) {
    width: 100%;
    height: auto;
  }

  /* Each photo opens in the full-screen viewer. */
  .project__open {
    display: block;
    cursor: zoom-in;
  }

  .project__open:focus-visible {
    outline-offset: -4px;
  }

  .project__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--frame);
  }

  @media (min-width: 48rem) {
    .project__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project__row--single {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .project__row--single .project__frame {
      width: calc(50% - var(--frame) / 2);
    }
  }

  /* Trios: three across (two on phones, the first photo spanning both),
     all cropped to the same 4:5 frame so every row lines up. */
  .project__gallery--trios {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project__gallery--trios .project__frame {
    aspect-ratio: 4 / 5;
  }

  .project__gallery--trios .project__frame:first-child {
    grid-column: 1 / -1;
  }

  .project__gallery--trios .project__open {
    height: 100%;
  }

  /* `zoom` scales towards `position` (both set per photo on the img). */
  .project__gallery--trios .project__frame :global(img) {
    height: 100%;
    object-fit: cover;
    scale: var(--zoom, 1);
  }

  @media (min-width: 48rem) {
    .project__gallery--trios {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .project__gallery--trios .project__frame:first-child {
      grid-column: auto;
    }
  }

  /* Rows: one to three as listed, each photo or film at its own
     proportions (set on the frame) and each column as wide as them
     (`--cols`), so a row's pieces share one height and fill the width.
     On phones a trio opens with its first photo across the full width
     and the other two side by side, again at one height (`--cols-rest`). */
  .project__gallery--rows .project__row {
    grid-template-columns: var(--cols);
  }

  @media (max-width: 47.99rem) {
    .project__gallery--rows .project__row--three {
      grid-template-columns: var(--cols-rest);
    }

    .project__gallery--rows .project__row--three .project__frame:first-child {
      grid-column: 1 / -1;
    }
  }

  /* A film keeps its proportions on phones. From tablet up it fills the
     screen instead: as wide as the page and as tall as the window (less
     the frame above and below), so it is seen whole, edge to edge, with
     its top and bottom trimmed a little if the screen is wider than it. */
  .project__frame--film {
    aspect-ratio: var(--ratio);
  }

  @media (min-width: 48rem) {
    .project__frame--film {
      aspect-ratio: auto;
      height: calc(100svh - 2 * var(--frame));
    }
  }

  .project__frame--film video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project__gallery--rows .project__open {
    height: 100%;
  }

  .project__gallery--rows .project__frame :global(img) {
    height: 100%;
    object-fit: cover;
    scale: var(--zoom, 1);
  }

  /* ---- Backstage: the vertical clips in one row ---- */

  .project__backstage {
    padding-top: var(--section-gap);
  }

  .project__label {
    margin: 0 var(--page-margin) var(--space-5);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.9rem, 1.3rem + 1.6vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* Framed like the photos. */
  .project__clips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Wider than the photos' frame: the clips are small, and need air. */
    --clip-gap: clamp(1rem, 2.4vw, 2.5rem);
    gap: var(--clip-gap);
    margin: 0;
    padding: 0 var(--frame);
    list-style: none;
  }

  /* On phones, an odd last clip sits alone in the middle of its row. */
  @media (max-width: 47.99rem) {
    .project__clip:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc(50% - var(--clip-gap) / 2);
    }
  }

  /* From tablet up, every clip in one row (up to five). Each clip is never
     wider than a quarter of the row (Rent the Look's four), so a brand with
     one to three clips shows them at that size, centred. */
  @media (min-width: 48rem) {
    .project__clips {
      grid-template-columns: repeat(
        var(--clips),
        calc((100% - (var(--slots) - 1) * var(--clip-gap)) / var(--slots))
      );
      justify-content: center;
    }
  }

  .project__clip video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: var(--color-ink-raised);
  }

  /* ---- Next work ---- */

  .project__next {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--section-gap) var(--page-margin);
  }

  .project__label-small {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .project__next-link {
    position: relative;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--step-5);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .project__next-link span {
    display: inline-block;
  }

  /* A wine rule draws under the name on hover. */
  .project__next-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .project__next-link:hover::after,
  .project__next-link:focus-visible::after {
    transform: scaleX(1);
  }

  .project__button {
    padding: 0.7rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-paper);
  }

  .project__button:hover,
  .project__button:focus-visible {
    color: var(--color-paper);
    background: transparent;
  }

  /* ---- Motion ---- */

  @media (prefers-reduced-motion: no-preference) {
    /* The name rises out of its own baseline on load. */
    .project__name {
      animation: project-rise 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    /* Arriving through a View Transition (flag set in BaseLayout), the
       name is already morphing in from the card: skip its own rise. */
    :global(.arrived-by-transition) .project__name {
      animation: none;
    }

    /* The clip only hides the name below its baseline: it reaches 0.1em
       past the sides so no letter whose stroke overhangs its box (K, A,
       V) loses its edge. */
    @keyframes project-rise {
      from {
        clip-path: inset(0 -0.1em 100% -0.1em);
        translate: 0 0.35em;
      }
      to {
        clip-path: inset(0 -0.1em -0.2em -0.1em);
        translate: 0 0;
      }
    }

    /* Photos: instead of the site-wide fade-up, each one is uncovered
       from the bottom edge as it scrolls in. The clip goes on the photo,
       not the frame: IntersectionObserver counts the observed element's
       own clip-path, so a fully clipped frame would never be "seen". */
    .project__frame[data-reveal] {
      transform: none;
      transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .project__frame[data-reveal] :global(img) {
      clip-path: inset(100% 0 0 0);
      transition: clip-path 1300ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .project__frame[data-reveal].is-visible :global(img) {
      clip-path: inset(0 0 0 0);
    }

    /* The right-hand photo of a pair arrives a beat later. */
    .project__frame[data-reveal]:nth-child(2),
    .project__frame[data-reveal]:nth-child(2) :global(img) {
      transition-delay: 140ms;
    }

    .project__row .project__frame[data-reveal]:nth-child(3),
    .project__row .project__frame[data-reveal]:nth-child(3) :global(img) {
      transition-delay: 280ms;
    }

    /* In a trio, each photo arrives a beat after the one to its left. */
    @media (min-width: 48rem) {
      .project__gallery--trios .project__frame[data-reveal]:nth-child(3n + 1),
      .project__gallery--trios .project__frame[data-reveal]:nth-child(3n + 1) :global(img) {
        transition-delay: 0ms;
      }

      .project__gallery--trios .project__frame[data-reveal]:nth-child(3n + 2),
      .project__gallery--trios .project__frame[data-reveal]:nth-child(3n + 2) :global(img) {
        transition-delay: 140ms;
      }

      .project__gallery--trios .project__frame[data-reveal]:nth-child(3n),
      .project__gallery--trios .project__frame[data-reveal]:nth-child(3n) :global(img) {
        transition-delay: 280ms;
      }
    }

    .project__clip:nth-child(2) {
      transition-delay: 80ms;
    }

    .project__clip:nth-child(3) {
      transition-delay: 160ms;
    }

    .project__clip:nth-child(4) {
      transition-delay: 240ms;
    }

    .project__clip:nth-child(5) {
      transition-delay: 320ms;
    }

    .project__next-link::after {
      transition: transform 500ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .project__button {
      transition:
        background-color 250ms ease,
        color 250ms ease;
    }

    /* A slow drift inside each frame while it crosses the screen. The
       photo is scaled up a little so the drift never shows an edge. */
    @supports (animation-timeline: view()) {
      .project__frame :global(img),
      .project__gallery--trios .project__frame :global(img) {
        scale: calc(1.1 * var(--zoom, 1));
        animation: project-drift linear both;
        animation-timeline: view();
      }

      @keyframes project-drift {
        from {
          translate: 0 -4%;
        }
        to {
          translate: 0 4%;
        }
      }
    }
  }
</style>

<script>
  // Backstage clips: silent autoplay only while on screen (so four videos
  // never play at once off-screen), unless the visitor prefers reduced
  // motion — then they keep their controls and play on demand.
  const clips = document.querySelectorAll<HTMLVideoElement>('[data-clip]');

  if (clips.length > 0 && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {
              // Autoplay refused (e.g. data saver): give the controls back.
              video.controls = true;
            });
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.25 },
    );

    clips.forEach((video) => {
      video.controls = false;
      video.preload = 'auto';
      observer.observe(video);
    });
  }
</script>
