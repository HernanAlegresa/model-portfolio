---
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { switchLocalePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getImage } from 'astro:assets';
import heroPhoto from '../assets/home/hero.png';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

const pathname = Astro.url.pathname;
const alternatePath = switchLocalePath(pathname, lang === 'es' ? 'en' : 'es');
// Only pages under /es/ or /en/ have a version in the other language (the
// 404 page, for one, doesn't).
const hasAlternate = /^\/(es|en)(\/|$)/.test(pathname);

// The preview card WhatsApp, Instagram and others show when the link is
// shared: a 1200 px JPEG of the Home's hero photo, with an absolute URL.
const shareImage = await getImage({ src: heroPhoto, width: 1200, format: 'jpg', quality: 82 });
const shareImageUrl = new URL(shareImage.src, Astro.site);
const canonical = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Paints the phone browser's bars in the site's black. -->
    <meta name="theme-color" content="#0c0c0d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hasAlternate && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hernán Alegresa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_UY' : 'en_US'} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(shareImage.attributes.width)} />
    <meta property="og:image:height" content={String(shareImage.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang="es" href={new URL(lang === 'es' ? pathname : alternatePath, Astro.site)} />
          <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? pathname : alternatePath, Astro.site)} />
        </>
      )
    }
    <!-- Cross-document View Transitions: pages cross-fade into each other,
         and elements sharing a view-transition-name morph across the
         navigation (a brand's name from its card into its page's title).
         Inline in the head, not in global.css: in the bundled stylesheet
         Chrome skipped the transition into the heavier pages (Home, a
         brand's page). Browsers without support just navigate normally. -->
    <style is:inline>
      @view-transition {
        navigation: auto;
      }

      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }
    </style>
    <!-- Flags a page that arrived through one of those transitions, so its
         own entrance animations can step aside for the morph. In the head
         so it's listening before the first frame. -->
    <script is:inline>
      addEventListener(
        'pagereveal',
        (event) => {
          if (event.viewTransition) document.documentElement.classList.add('arrived-by-transition');
        },
        { once: true },
      );

      // Remembers whether the last input was a pointer (mouse, finger) or
      // the keyboard. Safari on iPhone draws the keyboard focus outline
      // whenever a script moves focus (opening a viewer or the menu), even
      // after a tap; global.css hides that outline while data-input is
      // "pointer". The first key press brings it back for keyboard users.
      addEventListener('pointerdown', () => (document.documentElement.dataset.input = 'pointer'), true);
      addEventListener('keydown', () => (document.documentElement.dataset.input = 'keyboard'), true);
    </script>
  </head>
  <body>
    <Nav lang={lang} />
    <main>
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<script>
  // Scroll-reveal for [data-reveal] elements (see global.css). No-op on pages
  // that don't use the attribute, and respects prefers-reduced-motion by
  // marking everything visible immediately instead of observing.
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (targets.length > 0) {
    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
      );
      targets.forEach((el) => observer.observe(el));
    } else {
      targets.forEach((el) => el.classList.add('is-visible'));
    }
  }
</script>
